    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.20.5",
    "@types/three": "^0.180.0",
    "@webgpu/types": "^0.1.74",
    "eslint": "^10.15.0",
    "eslint-plugin-solid": "^0.20.0",
    "jiti": "^2.7.0",
    "jsrepo": "^3.8.3",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
