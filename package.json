    "@vgpu/wgsl": "^0.6.0",
    "face-api.js": "^0.22.2",
    "gl-matrix": "^3.4.4",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "maath": "^0.10.8",
    "mathjs": "^15.2.0",
    "matter-js": "^0.20.0",
    "meshline": "^3.3.1",
    "motion": "^14.14.0",
    "ogl": "^1.0.11",
    "postprocessing": "^6.39.6",
